{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "loadBalancers_tacoweb_lb_name": {
            "defaultValue": "tacoweb-lb",
            "type": "String"
        },
        "publicIPAddresses_tacoweb_publicIP_externalid": {
            "defaultValue": "/subscriptions/2213e8b1-dbc7-4d54-8aff-b5e315df5e5b/resourceGroups/943-89eb054f-deploy-an-azure-vm-scale-set-with-loa/providers/Microsoft.Network/publicIPAddresses/tacoweb-publicIP",
            "type": "String"
        }
    },
    "variables": {},
    "resources": [
        {
            "type": "Microsoft.Network/loadBalancers",
            "apiVersion": "2025-05-01",
            "name": "[parameters('loadBalancers_tacoweb_lb_name')]",
            "location": "eastus",
            "tags": {
                "source": "terraform"
            },
            "sku": {
                "name": "Standard",
                "tier": "Regional"
            },
            "properties": {
                "frontendIPConfigurations": [
                    {
                        "name": "myPublicIP",
                        "id": "[concat(resourceId('Microsoft.Network/loadBalancers', parameters('loadBalancers_tacoweb_lb_name')), '/frontendIPConfigurations/myPublicIP')]",
                        "properties": {
                            "privateIPAllocationMethod": "Dynamic",
                            "publicIPAddress": {
                                "id": "[parameters('publicIPAddresses_tacoweb_publicIP_externalid')]"
                            }
                        }
                    }
                ],
                "backendAddressPools": [
                    {
                        "name": "BackEndAddressPool",
                        "id": "[resourceId('Microsoft.Network/loadBalancers/backendAddressPools', parameters('loadBalancers_tacoweb_lb_name'), 'BackEndAddressPool')]",
                        "properties": {
                            "loadBalancerBackendAddresses": [
                                {
                                    "name": "bf68f31a-119f-45c3-842a-408be02e510e",
                                    "properties": {}
                                },
                                {
                                    "name": "69fd1943-11f6-4b67-99d4-fa1c2c30e900",
                                    "properties": {}
                                }
                            ]
                        }
                    }
                ],
                "loadBalancingRules": [
                    {
                        "name": "http",
                        "id": "[concat(resourceId('Microsoft.Network/loadBalancers', parameters('loadBalancers_tacoweb_lb_name')), '/loadBalancingRules/http')]",
                        "properties": {
                            "frontendIPConfiguration": {
                                "id": "[concat(resourceId('Microsoft.Network/loadBalancers', parameters('loadBalancers_tacoweb_lb_name')), '/frontendIPConfigurations/myPublicIP')]"
                            },
                            "frontendPort": 80,
                            "backendPort": 8080,
                            "enableFloatingIP": false,
                            "idleTimeoutInMinutes": 5,
                            "protocol": "Tcp",
                            "enableTcpReset": false,
                            "loadDistribution": "Default",
                            "disableOutboundSnat": false,
                            "enableConnectionTracking": false,
                            "backendAddressPool": {
                                "id": "[resourceId('Microsoft.Network/loadBalancers/backendAddressPools', parameters('loadBalancers_tacoweb_lb_name'), 'BackEndAddressPool')]"
                            },
                            "backendAddressPools": [
                                {
                                    "id": "[resourceId('Microsoft.Network/loadBalancers/backendAddressPools', parameters('loadBalancers_tacoweb_lb_name'), 'BackEndAddressPool')]"
                                }
                            ],
                            "probe": {
                                "id": "[concat(resourceId('Microsoft.Network/loadBalancers', parameters('loadBalancers_tacoweb_lb_name')), '/probes/http')]"
                            }
                        }
                    }
                ],
                "probes": [
                    {
                        "name": "http",
                        "id": "[concat(resourceId('Microsoft.Network/loadBalancers', parameters('loadBalancers_tacoweb_lb_name')), '/probes/http')]",
                        "properties": {
                            "protocol": "Http",
                            "port": 8080,
                            "requestPath": "/",
                            "intervalInSeconds": 5,
                            "numberOfProbes": 2,
                            "probeThreshold": 1,
                            "noHealthyBackendsBehavior": "AllProbedDown"
                        }
                    }
                ],
                "inboundNatRules": [],
                "outboundRules": [],
                "inboundNatPools": []
            }
        },
        {
            "type": "Microsoft.Network/loadBalancers/backendAddressPools",
            "apiVersion": "2025-05-01",
            "name": "[concat(parameters('loadBalancers_tacoweb_lb_name'), '/BackEndAddressPool')]",
            "dependsOn": [
                "[resourceId('Microsoft.Network/loadBalancers', parameters('loadBalancers_tacoweb_lb_name'))]"
            ],
            "properties": {
                "loadBalancerBackendAddresses": [
                    {
                        "name": "bf68f31a-119f-45c3-842a-408be02e510e",
                        "properties": {}
                    },
                    {
                        "name": "69fd1943-11f6-4b67-99d4-fa1c2c30e900",
                        "properties": {}
                    }
                ]
            }
        }
    ]
}